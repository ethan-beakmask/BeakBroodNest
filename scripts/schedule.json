{
    "_comment": "BeakBroodNest 集中式排程設定。scheduler.py 每 5 分鐘 tick 一次，檢查哪些任務到期。",
    "tasks": [
        {
            "name": "vitality_decay",
            "description": "知識原子活力衰減（每日 03:00）",
            "command": ["{venv_python}", "{scripts_dir}/vitality_decay.py", "--run"],
            "cron": "0 3 * * *",
            "enabled": true,
            "timeout_seconds": 120
        },
        {
            "name": "pg_backup",
            "description": "PostgreSQL 資料庫備份（每日 02:30）",
            "command": ["{venv_python}", "{scripts_dir}/pg_backup.py", "--run"],
            "cron": "30 2 * * *",
            "enabled": true,
            "timeout_seconds": 300
        },
        {
            "name": "uploaded_files_gc",
            "description": "上傳檔案孤兒清理（每日 03:30）",
            "command": ["{venv_python}", "{scripts_dir}/uploads_gc.py", "--run"],
            "cron": "30 3 * * *",
            "enabled": true,
            "timeout_seconds": 180
        },
        {
            "name": "nightly_review",
            "description": "每日復盤 Pipeline P0~P3（每日 08:45，通勤時段，避開夜間風扇噪音；cron 分鐘必須對齊 scheduler 5 分鐘 tick）",
            "command": ["{venv_python}", "{scripts_dir}/nightly_pipeline.py"],
            "cron": "45 8 * * *",
            "enabled": true,
            "timeout_seconds": 10800
        },
        {
            "name": "heartbeat_monitor",
            "description": "Heartbeat 監控（每 30 分鐘檢查所有排程的 heartbeat，超期則寫 alert 到 BBN inbox）",
            "command": ["{venv_python}", "{scripts_dir}/heartbeat_monitor.py", "--check"],
            "cron": "*/30 * * * *",
            "enabled": true,
            "timeout_seconds": 60
        },
        {
            "name": "p0_import_frequent",
            "description": "P0 JSONL 增量匯入（每 10 分鐘；匯入後 DB trigger NOTIFY 喚醒 pipeline_listener 跑 P1+P2，取代舊 p1_scan_frequent 輪詢）",
            "command": ["{venv_python}", "{scripts_dir}/db_importer.py", "-convertall", "--since", "2"],
            "cron": "*/10 * * * *",
            "enabled": true,
            "timeout_seconds": 600
        }
    ]
}
