{
    "_comment": "BeakCortex 集中式排程設定。scheduler.py 每 5 分鐘 tick 一次，檢查哪些任務到期。",
    "tasks": [
        {
            "name": "vitality_decay",
            "description": "知識原子活力衰減（每日 03:00）",
            "command": ["{venv_python}", "{scripts_dir}/vitality_decay.py", "--run"],
            "cron": "0 3 * * *",
            "enabled": true,
            "timeout_seconds": 120
        },
        {
            "name": "pg_backup",
            "description": "PostgreSQL 資料庫備份（每日 02:30）",
            "command": ["{venv_python}", "{scripts_dir}/pg_backup.py", "--run"],
            "cron": "30 2 * * *",
            "enabled": true,
            "timeout_seconds": 300
        },
        {
            "name": "uploaded_files_gc",
            "description": "上傳檔案孤兒清理（每日 03:30）",
            "command": ["{venv_python}", "{scripts_dir}/uploads_gc.py", "--run"],
            "cron": "30 3 * * *",
            "enabled": true,
            "timeout_seconds": 180
        },
        {
            "name": "nightly_review",
            "_temporary_note": "2026-05-01 暫加 --skip p2：P2 已知 timeout (3225 topics 超載 161 倍)。P2-1 三參數實作完成後請拿掉 --skip p2。詳見知識庫原子 4008。",
            "description": "每日復盤 Pipeline P0~P3（每日 08:25，通勤時段，避開夜間風扇噪音）",
            "command": ["{venv_python}", "{scripts_dir}/nightly_pipeline.py", "--skip", "p2"],
            "cron": "25 8 * * *",
            "enabled": true,
            "timeout_seconds": 3600
        }
    ]
}
