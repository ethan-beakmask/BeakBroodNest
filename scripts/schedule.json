{
    "_comment": "BeakCortex 集中式排程設定。scheduler.py 每 5 分鐘 tick 一次，檢查哪些任務到期。",
    "tasks": [
        {
            "name": "vitality_decay",
            "description": "知識原子活力衰減（每日 03:00）",
            "command": ["{venv_python}", "{scripts_dir}/vitality_decay.py", "--run"],
            "cron": "0 3 * * *",
            "enabled": true,
            "timeout_seconds": 120
        },
        {
            "name": "pg_backup",
            "description": "PostgreSQL 資料庫備份（每日 02:30）",
            "command": ["{venv_python}", "{scripts_dir}/pg_backup.py", "--run"],
            "cron": "30 2 * * *",
            "enabled": true,
            "timeout_seconds": 300
        }
    ]
}
