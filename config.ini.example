# BeakBroodNest 組態檔範本
# 複製為 config.ini 後修改為實際值
# config.ini 已在 .gitignore 中排除

[postgresql]
host = localhost
port = 5432
database = beak_broodnest
username = beak_broodnest
password = CHANGE-ME-TO-YOUR-DB-PASSWORD

[flask]
host = 127.0.0.1
port = 5170
debug = false
secret_key = CHANGE-ME-TO-RANDOM-STRING

[relay]
host = 127.0.0.1
port = 5200
token = CHANGE-ME-TO-RANDOM-TOKEN

[logging]
level = INFO
