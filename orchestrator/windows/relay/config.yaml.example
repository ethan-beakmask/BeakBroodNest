# BeakBroodNest Relay Receiver 設定檔範本
# 複製為 config.yaml 後填入實際路徑與位址。本檔屬於本機環境設定，不入版控。

server:
  port: 5200
  bind: "0.0.0.0"  # 對外監聽，正式環境請依實際需求收斂

mobaxterm:
  # MobaXterm 執行檔完整路徑
  path: 'C:\Path\To\MobaXterm.exe'
  # 預設 bookmark（-bookmark 參數值）
  default_bookmark: 'User sessions\<your-host> ([<tag>])'
  # 預設目標視窗識別字串（用於分頁切換比對）
  default_target: "[<tag>]"
